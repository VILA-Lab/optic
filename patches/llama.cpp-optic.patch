+static void gemma4_optic_gather(ggml_tensor * dst, int ith, int nth, void *) {
+    const ggml_tensor * codes = dst->src[0];
+    const ggml_tensor * books = dst->src[1];
+    const ggml_tensor * tokens = dst->src[2];
+    const int64_t groups = codes->ne[0];
+    const int64_t group_dim = books->ne[0];
+    for (int64_t i = ith; i < tokens->ne[0] * groups; i += nth) {
+        const int64_t row = i / groups;
+        const int64_t group = i % groups;
+        const int32_t token = ((const int32_t *) tokens->data)[row];
+        GGML_ASSERT(token >= 0 && token < codes->ne[1]);
+        // I8 carries the original unsigned bytes, including indices 128..255.
+        const uint8_t code = ((const uint8_t *) codes->data)[token * codes->nb[1] + group];
+        const auto * word = (const ggml_fp16_t *) ((const char *) books->data + group * books->nb[2] + code * books->nb[1]);
+        float * out = (float *) ((char *) dst->data + row * dst->nb[1]) + group * group_dim;
+        ggml_fp16_to_fp32_row(word, out, group_dim);
+    }
+}
